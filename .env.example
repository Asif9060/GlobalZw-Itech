# ─────────────────────────────────────────────────────────────────────────────
# Global Suntech — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → Data API. The URL looks like https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → "anon / public" (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API Keys → "service_role". SERVER ONLY — never expose this
# to the browser and never prefix it with NEXT_PUBLIC_. It bypasses Row Level
# Security, which is what lets the server write leads and read them in /admin.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the table names (only needed if you renamed them).
# SUPABASE_LEADS_TABLE=leads
# SUPABASE_SUBSCRIBERS_TABLE=newsletter_subscribers
# SUPABASE_SETTINGS_TABLE=site_settings

# ── Admin portal (/admin) ────────────────────────────────────────────────────
# The password for the admin portal login screen.
# Defaults to "solar123" in development only — you MUST set this in production.
ADMIN_PASSWORD=
# Optional: restrict the login to a single address. Leave blank for password-only.
ADMIN_EMAIL=
# Secret used to sign the admin session cookie. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# How long an admin session stays valid, in hours. Defaults to 12.
ADMIN_SESSION_HOURS=12

# ── Email notifications (Resend) ─────────────────────────────────────────────
# Without RESEND_API_KEY nothing is emailed; enquiries are still stored and still
# appear in the portal, and the customer still gets their reference number.
#
# 1. Create an account at https://resend.com and copy an API key
#    (API Keys → Create API Key, "Sending access" is enough).
# 2. Either verify a domain you own (Domains → Add Domain, then add the DNS
#    records), or leave LEAD_NOTIFICATION_FROM unset to use Resend's shared
#    sandbox sender — which only delivers to the address that owns the account.
RESEND_API_KEY=

# Who is told an enquiry arrived. Comma-separated for several people; they all
# receive the same message, so any of them can pick it up. Falls back to
# ADMIN_EMAIL above when this is blank, and sends nothing when both are blank.
LEAD_NOTIFICATION_TO=info@globalzw-itech.com

# The sender, as `Name <address@your-verified-domain>`. Must be on a domain
# verified in Resend, or delivery is rejected.
# LEAD_NOTIFICATION_FROM=Global Suntech <notifications@globalsuntech.com>

# By default an enquiry notification's Reply-To is the customer, so hitting
# Reply answers them rather than the automation. Set this to force every reply
# to one internal mailbox instead (a shared sales inbox, a ticketing system).
# LEAD_NOTIFICATION_REPLY_TO=

# `off` silences every notification without removing the credentials.
# EMAIL_NOTIFICATIONS=off
# Newsletter signups are notified about too. `off` here keeps enquiry
# notifications on while dropping the (much noisier) subscriber ones.
# SUBSCRIBER_NOTIFICATIONS=off

# ── Runtime ──────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs and the admin "view live" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Escape hatch for deployments that intentionally run without Supabase.
# Without this, a production build with no Supabase credentials refuses to
# serve the admin and returns 503 from the public lead API. Set to 1 only when
# you really do want the local file store in production (not recommended —
# it does not survive a redeploy on most hosts).
# ALLOW_LOCAL_STORE=1
